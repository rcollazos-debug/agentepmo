{
  "$schema": "https://opencode.ai/config.schema.json",
  "agent": {
    "compaction": { "hidden": true },
    "explore": { "hidden": true },
    "general": { "hidden": true },
    "summary": { "hidden": true },
    "title": { "hidden": true }
  },
  "mcp": {
    "gmail": {
      "type": "local",
      "command": ["npx", "-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "enabled": true
    },
    "notebooklm": {
      "type": "local",
      "command": ["/Users/rcollazos/.local/bin/notebooklm-mcp"],
      "enabled": true
    },
    "metabase": {
      "type": "local",
      "command": ["/bin/bash", "agents/.opencode/mcp/metabase-wrapper.sh"],
      "enabled": true
    },
    "google-calendar": {
      "type": "local",
      "command": ["npx", "-y", "@nspady/google-calendar-mcp"],
      "enabled": true
    }
  }
}
